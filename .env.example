# Local development defaults for the backend repository.
# Copy to .env and change the secrets before using anything beyond local dev.
PROJECT_NAME="Red Backend"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

DATABASE_URL=postgresql://postgres:changethis@localhost:5432/app
POSTGRES_PASSWORD=changethis

# Mount the development-only /private router (never enable in production)
ENABLE_PRIVATE_ROUTER=true

# --- Google sign-in (OIDC) -------------------------------------------------
# Same OAuth client as zuchat. The client id is public: it also ships in the SPA.
GOOGLE_CLIENT_ID=437820789284-v5n17o720mm9tpggdd2cb2q7v4vvqa1o.apps.googleusercontent.com
# Server-side OAuth client secret. Never expose this in the SPA.
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth
# Comma-separated allowlist of Google accounts. Empty means "any verified account".
ALLOWED_EMAILS=
# Password grant (POST /login/access-token). Turn off in production.
ENABLE_PASSWORD_LOGIN=true

# --- Mailbox polling (Gmail) -----------------------------------------------
# A separate OAuth client for the admin mailbox, not the sign-in client.
# Mint these with `make google-refresh-token`; never commit the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
